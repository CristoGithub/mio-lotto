/* Sfondo e Font */
.stApp {
    background-color: #f0f2f6;
}

/* Animazione di entrata per i Suggerimenti (Fade In) */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translate3d(0, 20px, 0);
    }
    to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
}

.stSuccess {
    animation: fadeInUp 0.8s ease-in-out;
    border-radius: 15px !important;
    border-left: 10px solid #10b981 !important;
}

/* Tabella Premium con effetto Hover animato */
table {
    border-radius: 15px;
    overflow: hidden;
}

tr {
    transition: background-color 0.3s ease;
}

tr:hover {
    background-color: #e2e8f0 !important;
}

/* Animazione Pulsante sui Ritardatari */
td:nth-last-child(2) {
    font-weight: bold;
    color: #b45309 !important;
    transition: transform 0.2s ease;
}

tr:hover td:nth-last-child(2) {
    transform: scale(1.15);
    display: inline-block; /* Necessario per lo scale su alcune versioni browser */
}

/* Sidebar Dark con transizione */
[data-testid="stSidebar"] {
    background-color: #0f172a !important;
    transition: width 0.3s ease;
}
